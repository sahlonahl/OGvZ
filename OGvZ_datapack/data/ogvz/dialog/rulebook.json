{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Rulebook",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "Rule 1:\n\n",
          "underlined": true
        },
        {
          "text": "No Unfair Game Modifications\n",
          "underlined": false
        },
        {
          "text": "This includes, but is not limited to, freecam mods, x-ray resource packs, and hacked clients.\n",
          "underlined": false
        }
      ],
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "Rule 2:\n\n",
          "underlined": true
        },
        {
          "text": "No Crossteaming\n",
          "underlined": false
        },
        {
          "text": "Monsters and dwarves cannot collaborate for gameplay advantages (examples include sharing items, or dwarves mining blocks for mobs to enter the keep)\n",
          "underlined": false
        }
      ],
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "Rule 3:\n\n",
          "underlined": true
        },
        {
          "text": "No Kit Combining As A Mob\n",
          "underlined": false
        },
        {
          "text": "Monsters are not allowed to share mob-kit items with eachother.\n",
          "underlined": false
        }
      ],
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "Rule 4:\n\n",
          "underlined": true
        },
        {
          "text": "No Gamethrowing\n",
          "underlined": false
        },
        {
          "text": "Examples of gamethrowing include, though are not limited to: dwarves breaking the shrine, dwarves teamkilling or suiciding, dwarves refusing to do their assigned class job. Mobs teamkilling, mobs griefing other mobs (i.e. webbing other mobs as spider)\n",
          "underlined": false
        }
      ],
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "Rule 5:\n\n",
          "underlined": true
        },
        {
          "text": "No Intentional Bug Exploitation\n",
          "underlined": false
        },
        {
          "text": "Mojang-coded or dvz-coded!\n",
          "underlined": false
        }
      ],
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "Rule 6:\n\n",
          "underlined": true
        },
        {
          "text": "Be Respectful\n",
          "underlined": false
        },
        {
          "text": "Respect other players and encourage a healthy and fun gameplay environment. Be nice, don't spam, and help others where you can.\n",
          "underlined": false
        }
      ],
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "Rule 7:\n\n",
          "underlined": true
        },
        {
          "text": "No evading mutes, tempbans, or other punishments\n",
          "underlined": false
        },
        {
          "text": "Examples include using the #in-game chat to speak after being muted, or using an alternate account to sign in\n",
          "underlined": false
        }
      ],
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "Rule 8:\n\n",
          "underlined": true
        },
        {
          "text": "Use common sense.\n",
          "underlined": false
        }
      ],
      "width": 300
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": "Close"
    }
  ]
}